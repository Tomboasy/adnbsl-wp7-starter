{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "42rem",
			"wideSize": "75rem",
			"allowCustomContentAndWideSize": false
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"background": true,
			"text": true,
			"heading": true,
			"button": true,
			"link": true,
			"palette": [
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#1a1a1a"
				},
				{
					"slug": "secondary",
					"name": "Secondary",
					"color": "#4a4a4a"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#2c5aa0"
				},
				{
					"slug": "foreground",
					"name": "Foreground",
					"color": "#1a1a1a"
				},
				{
					"slug": "background",
					"name": "Background",
					"color": "#ffffff"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#f4f4f5"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#5c5c5c"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "#e4e4e7"
				},
				{
					"slug": "success",
					"name": "Success",
					"color": "#216e4e"
				},
				{
					"slug": "warning",
					"name": "Warning",
					"color": "#8a6a00"
				},
				{
					"slug": "error",
					"name": "Error",
					"color": "#b42318"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": true,
			"textTransform": true,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "system-sans",
					"name": "System Sans",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif"
				},
				{
					"slug": "system-serif",
					"name": "System Serif",
					"fontFamily": "Georgia, \"Times New Roman\", Times, serif"
				},
				{
					"slug": "system-mono",
					"name": "System Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"name": "XS",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "sm",
					"name": "SM",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "1rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"slug": "md",
					"name": "MD",
					"size": "1.125rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "lg",
					"name": "LG",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "xl",
					"name": "XL",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "2-xl",
					"name": "2XL",
					"size": "2rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "3-xl",
					"name": "3XL",
					"size": "2.75rem",
					"fluid": {
						"min": "2.15rem",
						"max": "3rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "3.5rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4rem"
					}
				}
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": ["px", "rem", "%", "vh", "vw"],
			"spacingSizes": [
				{
					"slug": "xs",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "sm",
					"name": "SM",
					"size": "1rem"
				},
				{
					"slug": "md",
					"name": "MD",
					"size": "1.5rem"
				},
				{
					"slug": "lg",
					"name": "LG",
					"size": "clamp(1.5rem, 3vw, 2.5rem)"
				},
				{
					"slug": "xl",
					"name": "XL",
					"size": "clamp(2rem, 4vw, 3.5rem)"
				},
				{
					"slug": "2xl",
					"name": "2XL",
					"size": "clamp(2.5rem, 6vw, 5rem)"
				},
				{
					"slug": "section",
					"name": "Section",
					"size": "clamp(3rem, 8vw, 7rem)"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"radiusSizes": [
				{
					"slug": "none",
					"name": "None",
					"size": "0"
				},
				{
					"slug": "sm",
					"name": "SM",
					"size": "0.25rem"
				},
				{
					"slug": "md",
					"name": "MD",
					"size": "0.5rem"
				},
				{
					"slug": "lg",
					"name": "LG",
					"size": "1rem"
				},
				{
					"slug": "full",
					"name": "Full",
					"size": "999px"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "sm",
					"name": "Small",
					"shadow": "0 1px 2px rgb(0 0 0 / 0.06)"
				},
				{
					"slug": "md",
					"name": "Medium",
					"shadow": "0 8px 24px rgb(0 0 0 / 0.08)"
				},
				{
					"slug": "lg",
					"name": "Large",
					"shadow": "0 16px 48px rgb(0 0 0 / 0.12)"
				}
			]
		},
		"dimensions": {
			"aspectRatio": true,
			"minHeight": true,
			"defaultAspectRatios": false,
			"aspectRatios": [
				{
					"slug": "square",
					"name": "1:1",
					"ratio": "1"
				},
				{
					"slug": "4-3",
					"name": "4:3",
					"ratio": "4/3"
				},
				{
					"slug": "3-2",
					"name": "3:2",
					"ratio": "3/2"
				},
				{
					"slug": "16-9",
					"name": "16:9",
					"ratio": "16/9"
				},
				{
					"slug": "21-9",
					"name": "21:9",
					"ratio": "21/9"
				}
			]
		},
		"position": {
			"sticky": true
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			},
			"core/image": {
				"lightbox": {
					"enabled": true,
					"allowEditing": true
				}
			}
		},
		"custom": {
			"layout": {
				"content": "42rem",
				"wide": "75rem",
				"full": "100%",
				"reading": "40rem"
			},
			"radius": {
				"sm": "0.25rem",
				"md": "0.5rem",
				"lg": "1rem"
			},
			"transition": {
				"duration": "200ms",
				"easing": "cubic-bezier(0.2, 0, 0, 1)"
			},
			"container": {
				"padding": "clamp(1.25rem, 4vw, 2.5rem)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|foreground"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system-sans",
			"fontSize": "var:preset|font-size|base",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|md",
			"padding": {
				"top": "0",
				"right": "var:custom|container|padding",
				"bottom": "0",
				"left": "var:custom|container|padding"
			}
		},
		"css": "body { -webkit-font-smoothing: antialiased; }",
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var:preset|color|foreground"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|3-xl"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|2-xl"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|xl"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|lg"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|md"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|base"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|accent",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|background"
				},
				"typography": {
					"fontSize": "var:preset|font-size|sm",
					"fontWeight": "600",
					"textDecoration": "none"
				},
				"border": {
					"radius": "var:preset|border-radius|sm"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.25rem",
						"bottom": "0.75rem",
						"left": "1.25rem"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|secondary",
						"text": "var:preset|color|background"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|accent",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|sm"
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "var:preset|color|primary",
							"width": "1px",
							"style": "solid"
						},
						"color": {
							"background": "transparent",
							"text": "var:preset|color|primary"
						},
						":hover": {
							"color": {
								"background": "var:preset|color|primary",
								"text": "var:preset|color|background"
							}
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"background": "var:preset|color|border"
				},
				"border": {
					"color": "var:preset|color|border"
				}
			},
			"core/quote": {
				"border": {
					"color": "var:preset|color|accent",
					"width": "0 0 0 3px",
					"style": "solid"
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|md"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|lg"
				}
			},
			"core/code": {
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|foreground"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|system-mono",
					"fontSize": "var:preset|font-size|sm"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|sm",
						"right": "var:preset|spacing|sm",
						"bottom": "var:preset|spacing|sm",
						"left": "var:preset|spacing|sm"
					}
				},
				"border": {
					"radius": "var:preset|border-radius|sm"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|sm",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var:preset|font-size|md",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|foreground"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|foreground"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontSize": "var:preset|font-size|sm"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-full-width",
			"title": "Page pleine largeur",
			"postTypes": ["page"]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "En-tête",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Pied de page",
			"area": "footer"
		},
		{
			"name": "header-minimal",
			"title": "En-tête minimal",
			"area": "header"
		},
		{
			"name": "footer-minimal",
			"title": "Pied de page minimal",
			"area": "footer"
		}
	]
}
