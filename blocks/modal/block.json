{
	"$schema": "https://schemas.wp.org/wp/7.0/block.json",
	"apiVersion": 3,
	"name": "adnbsl/modal",
	"title": "Modal",
	"category": "adnbsl",
	"icon": "editor-expand",
	"description": "Dialogue accessible (élément dialog natif + Interactivity API).",
	"keywords": ["dialog", "popup", "lightbox"],
	"textdomain": "adnbsl-wp7-starter",
	"attributes": {
		"triggerLabel": {
			"type": "string",
			"default": "Ouvrir"
		}
	},
	"supports": {
		"align": ["wide"],
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
